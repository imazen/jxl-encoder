Cargo.lock
# The apidoc snapshot runner is a standalone package; pin its lockfile.
!apidoc/Cargo.lock
*.orig
comparison_outputs/
test_baselines/
test_images/
*.zst
callgrind.out.*
debug_rect.csv
*.debug_rect.csv

# === Standard exclusions (do not depend on user ~/.gitignore) ===

# Rust build artifacts
target/

# Fuzz build artifacts and crashes
fuzz/target/
fuzz/artifacts/

# Profiling
perf.data
perf.data.old
flamegraph.svg
heaptrack.*.zst
cachegrind.out.*
callgrind.out.*
massif.out.*

# C/C++ build artifacts
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.rlib

# Compiled binaries with no extension
rust_out

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# Tooling noise
.superwork/
.claude/
copter-report/
.zenbench/
.external-cache/
Cargo.toml.original.txt
*.rs.local
*.profraw
*.profdata
fuzz-*.log
.workongoing
__pycache__/
*.pyc

# Picker oracle TSVs (large; archived to /mnt/v/output/jxl-encoder/picker-oracle-*/ until we decide on git-lfs vs direct)
jxl-encoder/benchmarks/*.tsv
zenjxl-tuning-runner-bin
zen-metrics-bin

# Benchmark plot artifacts: PNGs don't compress in git and bloat history.
# Regenerable via scripts/zenjxl-tuning-sweep/run_all_analyses.py — keep the
# .tsv / .md / .json results, not the plot images.
benchmarks/**/*.png
.jj/
