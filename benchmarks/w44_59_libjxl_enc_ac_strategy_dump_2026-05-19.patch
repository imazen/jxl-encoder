+// W44-59: per-coefficient AFV dump infrastructure.
+// Activates when ALL of the following env vars are set:
+//   JXL_DUMP_AFV_PATH=/path/to/dump.tsv
+//   JXL_DUMP_AFV_KIND=<14..17>  (libjxl's AcStrategy enum: 14=AFV0..17=AFV3)
+//   JXL_DUMP_AFV_X=<pixel_x>
+//   JXL_DUMP_AFV_Y=<pixel_y>
+// Dump format: stage<TAB>raw_strategy<TAB>x<TAB>y<TAB>c<TAB>i<TAB>value
+// Stages match the Rust dump: pixels (only NOT dumped here since libjxl's input
+// is the source XYB and matches at the call boundary), coeffs, inv_weights,
+// weights, per_coeff_val/rval/diff/weighted_diff, pixel_error, aggregate.*
+static thread_local FILE* w44_59_afv_fp = []() -> FILE* {
+  const char* p = std::getenv("JXL_DUMP_AFV_PATH");
+  if (p == nullptr || p[0] == '\0') return nullptr;
+  FILE* f = std::fopen(p, "a");
+  if (f == nullptr) return nullptr;
+  std::fseek(f, 0, SEEK_END);
+  if (std::ftell(f) == 0) {
+    std::fprintf(f, "stage\traw_strategy\tx\ty\tc\ti\tvalue\n");
+  }
+  return f;
+}();
+static thread_local int w44_59_afv_target_kind = []() -> int {
+  const char* p = std::getenv("JXL_DUMP_AFV_KIND");
+  if (p == nullptr || p[0] == '\0') return -1;
+  return std::atoi(p);
+}();
+static thread_local size_t w44_59_afv_target_x = []() -> size_t {
+  const char* p = std::getenv("JXL_DUMP_AFV_X");
+  if (p == nullptr || p[0] == '\0') return SIZE_MAX;
+  return static_cast<size_t>(std::atoll(p));
+}();
+static thread_local size_t w44_59_afv_target_y = []() -> size_t {
+  const char* p = std::getenv("JXL_DUMP_AFV_Y");
+  if (p == nullptr || p[0] == '\0') return SIZE_MAX;
+  return static_cast<size_t>(std::atoll(p));
+}();
+static inline bool W44_59_AfvCoeffTarget(unsigned strategy, size_t x, size_t y) {
+  return w44_59_afv_fp != nullptr && w44_59_afv_target_kind >= 0 &&
+         static_cast<int>(strategy) == w44_59_afv_target_kind &&
+         x == w44_59_afv_target_x && y == w44_59_afv_target_y;
+}
+static inline void W44_59_DumpBlock(const char* stage, unsigned raw_strategy,
+                                    size_t x, size_t y, size_t c,
+                                    const float* data, size_t n) {
+  for (size_t i = 0; i < n; i++) {
+    std::fprintf(w44_59_afv_fp, "%s\t%u\t%zu\t%zu\t%zu\t%zu\t%.8e\n",
+                 stage, raw_strategy, x, y, c, i,
+                 static_cast<double>(data[i]));
+  }
+}
+static inline void W44_59_DumpAggregate(const char* name, unsigned raw_strategy,
+                                        size_t x, size_t y, size_t c,
+                                        float value) {
+  std::fprintf(w44_59_afv_fp, "aggregate.%s\t%u\t%zu\t%zu\t%zu\t0\t%.8e\n",
+               name, raw_strategy, x, y, c, static_cast<double>(value));
+}
