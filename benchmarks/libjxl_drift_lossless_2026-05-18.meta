# libjxl HEAD drift bench — lossless (W19-2)
#
# Compares OLD cjxl (d2c7032) vs NEW cjxl (4279d48) vs our cjxl-rs on
# 5 CLIC 1024x1024 photos at -d 0 -e 7. Bytes only (lossless = pixel-exact).
date_utc=2026-05-18
host=lilith
old_cjxl=cjxl v0.12.0 d2c7032 [_AVX3_,AVX2,SSE4,SSE2] {GNU 11.4.0}
new_cjxl=cjxl v0.12.0 4279d48 [_AVX3_,AVX2,SSE4,SSE2] {GNU 11.4.0}
images=clic2025-1024 [02809272, 0369d229, 07b9f93f, 097cb426, 0c49a5cc]
effort=7
script=scripts/libjxl_drift_lossless.sh
finding=cjxl_old and cjxl_new produce BYTE-IDENTICAL lossless output on all 5 images. Our encoder is -0.9% smaller than cjxl_new on 4/5 images (097cb426 -5.8%, 02809272 -0.8%, 07b9f93f -1.0%, 0369d229 -1.0%; 0c49a5cc +0.2%).
