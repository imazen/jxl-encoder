WS=~/work/zen/jxl-encoder--w44-107-fix-codec-wiki-e8-d3
export CARGO_TARGET_DIR=$HOME/work/zen/jxl-encoder-shared-target
cd $WS

# Build with W44-107
cargo build -p jxl-encoder-cli --release --features 'parallel butteraugli-loop ssim2-loop'

# Re-run a single cell
cargo run -p jxl-encoder --release --features 'parallel butteraugli-loop ssim2-loop' \
  --example cjxl_parity_ledger -- \
  --output benchmarks/w44_107_tighten_gate_d35_2026-05-20.tsv \
  --ledger benchmarks/w44_107_tighten_gate_d35_2026-05-20.tsv \
  --update \
  --image codec_wiki.png \
  --effort 8 \
  --distance 3.0
```

