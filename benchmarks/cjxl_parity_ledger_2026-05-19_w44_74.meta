corpus: /home/lilith/work/codec-corpus
wall_seconds: 23.8
total_rows: 595
cells_this_run: 18
update_mode: true
status_filter: Some("OPEN")
smoke: false
decoder: jxl-oxide (request_color_encoding=srgb_linear)
metrics: butteraugli_linear (default params), fast_ssim2 (sRGB u8 from linear)
section_parser: inline (jxl-frame::data::Toc, ContainerParser-stripped)
wedge_thresholds: bytes_delta_pct > 3 AND (bfly_delta_pct > 3 OR ssim2_delta_abs < -1)

