date: 2026-05-17
purpose: RFC#45 chunks 4-7 lossless backport — calibration sweep
corpus: gb82-sc (5 screenshots) + CID22-512 validation (5 photos)
config: LosslessConfig::new() (default effort=7 enables patches);
        patches_off variant uses .with_patches(false)
build:
  jjj_main_origin: cbb364785 (perf(splines): recalibrate cost gate ... 50.0 → 0.20)
  workspace_change: 91ab8d13 (wip(patches): lossless gate recalibrate)
host: $(uname -n) (Ryzen 9 7950X, 128 GB RAM)
cargo: stable
features: __internals
example: jxl-encoder/examples/patches_lossless_calibrate.rs
command: |
  cargo run --release -p jxl-encoder --features __internals \
      --example patches_lossless_calibrate \
      > benchmarks/patches_lossless_savings_calibrate_2026-05-17.tsv \
      2>/dev/null

columns:
  - class:                 screenshot | photo
  - image:                 file name
  - width / height:        image dims
  - bytes_off:             encoded bytes with .with_patches(false)
  - bytes_on:              encoded bytes with default LosslessConfig (patches auto)
  - actual_savings_B:      bytes_off - bytes_on (positive = patches save bytes)
  - total_patch_pixels:    sum over occurrences of ref_xsize*ref_ysize
  - unique_refs:           number of unique patch templates after gate
  - ref_frame_pixels:      ref_width * ref_height
  - occurrences:           total patch placements
  - ref_overhead_B:        trial_encode_ref_frame_bytes(pd, use_ans=true)
  - dict_overhead_B:       trial_encode_dict_section_bytes(pd, use_ans=true)
  - total_overhead_B:      ref + dict
  - empirical_bpp:         actual_savings_B / total_patch_pixels

findings:
  screenshots_detected: 5 of 5 (all produced PatchesData)
  photos_detected:      0 of 5 (all returned None — sub-1% coverage)
  net_bpp_min:          0.048  (windows95.png)
  net_bpp_median:       0.272  (imac_g3.png)
  net_bpp_geomean:      0.27   (5-image fit)

calibration_constant_shipped: SAVINGS_BYTES_PER_PIXEL_LOSSLESS = 0.45
calibration_constant_rationale:
  Geomean net bpp = 0.27, but trial_encode overhead overshoots actual
  lossless ref-frame byte cost by ~1.5-2x (it invokes the XYB-shape
  path). To admit all 8 measured net-winning cells (5 from this run
  + 3 from extended-corpus run) at the chunk-6 1.5x safety margin,
  C must be >= 0.4371. Round up to 0.45 with margin.
