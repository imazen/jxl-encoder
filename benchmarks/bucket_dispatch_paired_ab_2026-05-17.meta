# Paired A/B bench metadata — tree_max_buckets dispatch (audit item #3)

bench_name: bucket_dispatch_paired_ab
chunk: audit #3 (conditional-value catalog item #3, commit 4572790 Pareto sweep resurrection)
date_utc: 2026-05-17
host: lilith (Linux 6.6.114.1-microsoft-standard-WSL2)
cpu: AMD Ryzen 9 7950X (32 threads, water-cooled)
rustc: 1.95.0 (59807616e 2026-04-14)

git_parent: 142ef4f6 (feat(tree_learn): opt-in pixel-count + effort gated small-image cache fallback)
features_built: parallel-tree-learning __expert
profile: release (no -C target-cpu=native — runtime SIMD dispatch is what users get)

# Bench design
samples_per_cell: 7  (paired A/B, sample-major interleaved)
threads: 8           (RAYON_NUM_THREADS=8, lossless default)
efforts: 7, 8, 9     (3 cells × 3 efforts × 3 images = 9 cells × 2 variants × 7 samples)

images:
  small_0.26MP:  /home/lilith/work/codec-corpus/CID22/CID22-512/training/7256805.png
  medium_1.05MP: /home/lilith/work/codec-corpus/clic2025-1024/02809272b4ca9b08af45771501b741296187c7e26907efb44abbbfcb6cd804f7.png
  large_4.19MP:  /home/lilith/work/codec-corpus/clic2025/final-test/8426ed2245c791232862b0a0b2a62a1f17031e8e6e38921fe939df0b3a05ac41.png

# Variant definitions
variant_A: dispatch ON (new default).
           LosslessConfig::effective_profile_for_image(pixels) calls
           EffortProfile::adapt_tree_max_buckets_for_image(pixels).
           At (pixels >= 4_000_000 && effort >= 9), drops tree_max_buckets 256 -> 192.
           All other cells: effort default (96 at e7, 128 at e8, 256 at e9).
variant_B: dispatch OFF.
           __expert override: LosslessInternalParams::tree_max_buckets = Some(effort_default).
           effective_profile_for_image skips the dispatch when profile_override is Some.
           Reproduces the pre-dispatch baseline for every effort.

# Acceptance gates (per task brief)
gate_large_e9_wallclock: large+e9 must show >= 5% improvement
gate_large_e9_bytes:     large+e9 bytes must stay within +0.5% of variant B
gate_other_cells_bytes:  all 8 non-(large+e9) cells must be byte-identical (sha256 prefix match)
gate_other_cells_wallclock: variance only (no expected delta — dispatch does not fire)

# Source references
audit_memory: ~/.claude/projects/-home-lilith-work-zen-jxl-encoder/memory/rejected_optimizations_conditional_value_2026-05-17.md
pareto_source: commit 4572790 / benchmarks/tree_max_buckets_pareto_2026-05-17.tsv
dispatch_pattern_precedents:
  - 1c4691f0 (smart-fanout dispatch via tree_parallel_smart opt-in)
  - 142ef4f6 (small-image-fallback opt-in dispatch)
  - this commit (always-on bucket dispatch — bytes change at large+e9 is intentional)

# Columns
column_image:          basename of the .png input (corpus path)
column_label:          synthetic class tag (small_0.26MP / medium_1.05MP / large_4.19MP)
column_width:          input width
column_height:         input height
column_megapixels:     w * h / 1_000_000
column_effort:         lossless effort (7, 8, or 9)
column_sample:         sample index (1..N, paired)
column_variant:        A = dispatch ON, B = dispatch OFF
column_bytes:          encoded output size
column_encode_ms:      wall-clock encode time in ms
column_sha256_prefix:  first 8 bytes of SHA256(output) as hex u64 (byte-identity check)

