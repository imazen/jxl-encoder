# W44-185 ARC-CLOSING comprehensive cjxl-parity sweep
# Same harness as W44-170 / W44-179; re-run on post-W44-184 HEAD to measure
# CUMULATIVE impact of the 15-chunk arc (W44-170 → W44-184) shipped 2026-05-21
# through 2026-05-22.
date: 2026-05-22
commit: 89e3c405809a53c2872179d05bda80a69503b2fb
host: lilith
cjxl_version: cjxl v0.12.0 4279d48 [_AVX3_,AVX2,SSE4,SSE2] {GNU 11.4.0}
manifest: benchmarks/corpora/w44_170_varied_corpus.tsv
corpus_dir: /home/lilith/work/codec-corpus
strategies: ["zenjxl", "libjxl"]
distance_grid: [0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5, 2.75, 3.0, 3.25, 3.5, 3.75, 4.0, 4.25, 4.5, 4.75, 5.0]
efforts: [5, 6, 7, 8, 9]
time_iters: 1
smoke: false
decoder: jxl-oxide (srgb_linear)
metrics: butteraugli_linear (default params); fast_ssim2 (sRGB u8 from linear)
tsv_outputs:
  libjxl: benchmarks/cjxl_step025_w44_185_libjxl_2026-05-22.tsv
  zenjxl: benchmarks/cjxl_step025_w44_185_zenjxl_2026-05-22.tsv
reproducer (full sweep):
  cargo run -p jxl-encoder --release --features 'parallel butteraugli-loop ssim2-loop' --example w44_170_cjxl_step025_sweep -- --corpus-manifest benchmarks/corpora/w44_170_varied_corpus.tsv --output-prefix benchmarks/cjxl_step025_w44_185 --strategies zenjxl,libjxl

