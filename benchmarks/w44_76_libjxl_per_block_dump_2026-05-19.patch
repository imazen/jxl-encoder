+        // W44-76: per-block dump (raw_strategy is libjxl wire enum directly).
+        if (FILE* dump = W44_76_DumpFile()) {
+          // qf is per-pixel quant-field; per-block raw_quant is at sbx[c]
+          // (post-subsampling x).  Use row_qf which is the rect's row offset.
+          const int32_t qac_val = row_qf[sbx[c]];
+          std::fprintf(dump, "%zu\t%zu\t%u\t%d\t%d\t%d\n",
+                       rect.x0() + bx, rect.y0() + by,
+                       static_cast<unsigned>(acs.RawStrategy()), c, nzeros,
+                       qac_val);
+        }
+
         int ord = kStrategyOrder[acs.RawStrategy()];
