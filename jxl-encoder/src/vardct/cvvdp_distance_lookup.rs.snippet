/// Linear interpolation: given a target JOD, return the distance from
/// the lookup table. Clamps outside the table range. Returns the table's
/// max-distance entry if `target_jod` is below the table's min cvvdp;
/// returns the table's min-distance entry if `target_jod` is above the max.
pub(crate) fn lookup_distance_for_target_jod(table: &[(f32, f32)], target_jod: f32) -> f32 {
    if table.is_empty() {
        return 1.0;  // safe default
    }
    let first = table[0];
    let last = table[table.len() - 1];
    if target_jod <= first.0 {
        return last.1;  // very lossy target → highest distance in table
    }
    if target_jod >= last.0 {
        return first.1;  // very strict target → lowest distance in table
    }
    for w in table.windows(2) {
        let (jod_lo, d_lo) = w[0];
        let (jod_hi, d_hi) = w[1];
        if jod_lo <= target_jod && target_jod <= jod_hi {
            let t = (target_jod - jod_lo) / (jod_hi - jod_lo);
            return d_lo + t * (d_hi - d_lo);
        }
    }
    1.0  // unreachable in practice
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn default_table_monotone_in_jod() {
        let t = CVVDP_DISTANCE_LOOKUP_DEFAULT;
        assert!(t.len() >= 2);
        for w in t.windows(2) {
            assert!(w[0].0 < w[1].0, "jod must be strictly increasing");
            assert!(w[0].1 >= w[1].1, "distance must be monotone non-increasing as jod target tightens");
        }
    }

    #[test]
    fn lookup_clamps_outside_range() {
        let t = CVVDP_DISTANCE_LOOKUP_DEFAULT;
        let very_lossy = lookup_distance_for_target_jod(t, 0.0);
        let very_strict = lookup_distance_for_target_jod(t, 100.0);
        assert!(very_lossy >= very_strict);
    }

    #[test]
    fn lookup_interpolates_inside_range() {
        let t = CVVDP_DISTANCE_LOOKUP_DEFAULT;
        if t.len() >= 2 {
            let mid_jod = (t[0].0 + t[t.len() - 1].0) / 2.0;
            let d = lookup_distance_for_target_jod(t, mid_jod);
            assert!(d > 0.0);
            assert!(d < 100.0);
        }
    }
}
