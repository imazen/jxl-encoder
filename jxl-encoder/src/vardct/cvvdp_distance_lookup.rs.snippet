//! cvvdp target-JOD → effective-distance calibration table (Phase 8b).
//!
//! Built from Phase 6 tracking TSV:
//!   benchmarks/cvvdp_vs_buttloop_tracking_2026-05-24.tsv
//!
//! For each (corpus, target_jod), the table records the MEDIAN distance
//! at which butteraugli's buttloop achieves cvvdp_gpu ≈ target_jod on that
//! corpus, across all images at effort=8.
//!
//! Use case: `LossyConfig::with_cvvdp_target_jod(jod)` looks up the
//! distance that achieves `jod`, then runs the butteraugli buttloop at
//! that distance. Output sits on the Pareto front per Phase 8a diagnosis.
//!
//! Linear interpolation between table points; clamp outside [min, max].

/// Phase 6 commit SHA the table was extracted from.
pub(crate) const CALIBRATION_SOURCE: &str = "Phase 6 sweep, cvvdp-fork-rfc 8b5a13a7";

/// Default (blended across all corpora). Lookup: target_jod → distance.
pub(crate) static CVVDP_DISTANCE_LOOKUP_DEFAULT: &[(f32, f32)] = &[
    (9.500, 4.5726),
    (9.600, 4.3587),
    (9.700, 4.5221),
    (9.800, 3.6330),
    (9.850, 2.9966),
    (9.900, 2.2925),
    (9.930, 1.8606),
    (9.950, 1.5579),
    (9.970, 1.1902),
    (9.980, 0.9863),
    (9.990, 0.7380),
];

